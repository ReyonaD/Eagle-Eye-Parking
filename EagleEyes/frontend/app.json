{
  "expo": {
    "name": "EagleEyes",
    "slug": "frontend",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/EagleEyeLogo.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parkzen.eagleeyes.capstone",
      "config": {
        "googleMapsApiKey": "AIzaSyAeKFvAPWQat4h6U_sMDIxERr8Oy2b4t8U"
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch",
          "processing"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.parkzen.refresh"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "EagleEyes needs your location to detect when you park on campus.",
        "NSLocationWhenInUseUsageDescription": "EagleEyes needs your location to show lots near you.",
        "NSLocationAlwaysUsageDescription": "EagleEyes needs background location to remember your parking spot.",
        "NSMotionUsageDescription": "EagleEyes uses motion data to detect when you stop driving."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/EagleEyeLogo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.frontend",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAeKFvAPWQat4h6U_sMDIxERr8Oy2b4t8U"
        }
      },
      "permissions": [
        "INTERNET",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "BLUETOOTH",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_ADVERTISE",
        "BLUETOOTH_CONNECT",
        "ACTIVITY_RECOGNITION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#00853E"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "EagleEyes needs access to your photos so you can attach pictures to a hazard report.",
          "cameraPermission": "EagleEyes needs access to your camera so you can take a photo for a hazard report."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "39024e53-7f34-4924-87d9-257bfc49fc81"
      }
    },
    "owner": "alperend",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/39024e53-7f34-4924-87d9-257bfc49fc81"
    }
  }
}